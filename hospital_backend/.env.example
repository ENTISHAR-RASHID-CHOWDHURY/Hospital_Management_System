# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3001

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_backend

# Required. The server will not start without it, and placeholders like
# "change-me" are refused. In production it must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional separate secret for refresh tokens (defaults to JWT_SECRET).
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed browser origins, comma-separated. Required in production.
# Outside production, any localhost / 127.0.0.1 port is also allowed.
FRONTEND_URL=

# Number of reverse proxies in front of the server (e.g. 1 behind nginx or a
# load balancer). Leave at 0 when clients connect directly; otherwise clients
# can fake their IP address and get around rate limiting.
TRUST_PROXY_HOPS=0

# Developer tools (/api/developer): sign in as seeded demo users to try each
# role. Off unless set to true; the server refuses to start with it on in
# production. DEVELOPER_PHRASE is required when enabled and must also be passed
# to the app: flutter run --dart-define=DEVELOPER_PHRASE=...
DEVELOPER_MODE=false
DEVELOPER_PHRASE=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=12
